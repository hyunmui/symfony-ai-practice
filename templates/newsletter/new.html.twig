{% extends 'base.html.twig' %}

{% block title %}새 뉴스레터 작성{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-pencil-square me-2"></i>새 뉴스레터 작성</h2>
    <a href="{{ path('newsletter_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>목록으로
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header p-3">뉴스레터 정보</div>
            <div class="card-body">
                {{ form_start(form, {attr: {id: 'newsletter-form'}}) }}
                <div class="mb-3">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.subject) }}
                    {{ form_widget(form.subject) }}
                    {{ form_errors(form.subject) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.content) }}
                    {{ form_widget(form.content) }}
                    {{ form_errors(form.content) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>저장
                    </button>
                    <a href="{{ path('newsletter_index') }}" class="btn btn-outline-secondary">취소</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header p-3" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px 12px 0 0 !important;">
                <i class="bi bi-robot me-2"></i>AI 콘텐츠 생성
            </div>
            <div class="card-body">
                <p class="text-muted small">AI를 활용해 뉴스레터 콘텐츠를 자동으로 생성하세요.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">주제</label>
                    <input type="text" id="ai-topic" class="form-control" placeholder="예: 2024년 기술 트렌드">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">어조</label>
                    <select id="ai-tone" class="form-select">
                        <option value="전문적인">전문적인</option>
                        <option value="친근한">친근한</option>
                        <option value="공식적인">공식적인</option>
                        <option value="유머러스한">유머러스한</option>
                        <option value="감성적인">감성적인</option>
                    </select>
                </div>
                <div class="d-grid gap-2">
                    <button type="button" id="btn-gen-subject" class="btn btn-outline-secondary btn-sm" onclick="generateAI('subject')">
                        <span class="ai-text"><i class="bi bi-magic me-1"></i>이메일 제목 생성</span>
                        <span class="ai-spinner spinner-border spinner-border-sm" role="status"></span>
                    </button>
                    <button type="button" id="btn-gen-content" class="btn btn-sm" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border: none; color: white;" onclick="generateAI('content')">
                        <span class="ai-text"><i class="bi bi-magic me-1"></i>콘텐츠 생성</span>
                        <span class="ai-spinner spinner-border spinner-border-sm" role="status"></span>
                    </button>
                </div>
                <div id="ai-error" class="alert alert-danger mt-3 d-none"></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const generateUrl = '{{ path('newsletter_ai_generate') }}';

async function generateAI(type) {
    const topic = document.getElementById('ai-topic').value.trim();
    const tone = document.getElementById('ai-tone').value;
    const errorEl = document.getElementById('ai-error');
    const btnId = type === 'subject' ? 'btn-gen-subject' : 'btn-gen-content';
    const btn = document.getElementById(btnId);

    if (!topic) {
        errorEl.textContent = '주제를 입력해주세요.';
        errorEl.classList.remove('d-none');
        return;
    }

    errorEl.classList.add('d-none');
    btn.classList.add('loading');
    btn.disabled = true;

    try {
        const response = await fetch(generateUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: new URLSearchParams({topic, tone, type})
        });

        const data = await response.json();

        if (data.error) {
            errorEl.textContent = data.error;
            errorEl.classList.remove('d-none');
        } else if (type === 'subject') {
            document.querySelector('#newsletter-form [name$="[subject]"]').value = data.content;
            document.querySelector('#newsletter-form [name$="[title]"]').value = topic;
        } else {
            document.querySelector('#newsletter-form [name$="[content]"]').value = data.content;
        }
    } catch (e) {
        errorEl.textContent = '서버 오류가 발생했습니다.';
        errorEl.classList.remove('d-none');
    } finally {
        btn.classList.remove('loading');
        btn.disabled = false;
    }
}
</script>
{% endblock %}
