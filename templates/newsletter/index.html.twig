{% extends 'base.html.twig' %}

{% block title %}뉴스레터 목록{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-newspaper me-2"></i>뉴스레터</h2>
    <a href="{{ path('newsletter_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>새 뉴스레터 작성
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        {% if newsletters is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-3">작성된 뉴스레터가 없습니다.</p>
                <a href="{{ path('newsletter_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>새 뉴스레터 작성
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>제목</th>
                        <th>이메일 제목</th>
                        <th>상태</th>
                        <th>작성일</th>
                        <th>발송일</th>
                        <th>관리</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for newsletter in newsletters %}
                        <tr>
                            <td class="ps-3 text-muted">{{ newsletter.id }}</td>
                            <td>
                                <a href="{{ path('newsletter_show', {id: newsletter.id}) }}" class="text-decoration-none fw-semibold">
                                    {{ newsletter.title }}
                                </a>
                            </td>
                            <td class="text-muted">{{ newsletter.subject }}</td>
                            <td>
                                {% if newsletter.isDraft() %}
                                    <span class="badge bg-warning text-dark">초안</span>
                                {% else %}
                                    <span class="badge bg-success">발송됨</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ newsletter.createdAt|date('Y-m-d H:i') }}</td>
                            <td class="text-muted">{{ newsletter.sentAt ? newsletter.sentAt|date('Y-m-d H:i') : '-' }}</td>
                            <td>
                                <a href="{{ path('newsletter_show', {id: newsletter.id}) }}" class="btn btn-sm btn-outline-primary me-1">보기</a>
                                {% if newsletter.isDraft() %}
                                    <a href="{{ path('newsletter_edit', {id: newsletter.id}) }}" class="btn btn-sm btn-outline-secondary">수정</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
