{% extends 'base.html.twig' %}

{% block title %}구독자 수정{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-person-gear me-2"></i>구독자 수정</h2>
    <a href="{{ path('subscriber_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>목록으로
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header p-3">구독자 정보 수정</div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-4 form-check">
                    {{ form_widget(form.active) }}
                    {{ form_label(form.active) }}
                    {{ form_errors(form.active) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>저장
                    </button>
                    <a href="{{ path('subscriber_index') }}" class="btn btn-outline-secondary">취소</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
