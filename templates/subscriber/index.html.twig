{% extends 'base.html.twig' %}

{% block title %}구독자 관리{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-people-fill me-2"></i>구독자 관리</h2>
    <a href="{{ path('subscriber_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>구독자 추가
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        {% if subscribers is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-plus" style="font-size:3rem;"></i>
                <p class="mt-3">등록된 구독자가 없습니다.</p>
                <a href="{{ path('subscriber_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>구독자 추가
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>이름</th>
                        <th>이메일</th>
                        <th>상태</th>
                        <th>구독일</th>
                        <th>관리</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for subscriber in subscribers %}
                        <tr>
                            <td class="ps-3 text-muted">{{ subscriber.id }}</td>
                            <td>{{ subscriber.name ?? '-' }}</td>
                            <td>{{ subscriber.email }}</td>
                            <td>
                                {% if subscriber.isActive() %}
                                    <span class="badge bg-success">활성</span>
                                {% else %}
                                    <span class="badge bg-secondary">비활성</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ subscriber.subscribedAt|date('Y-m-d H:i') }}</td>
                            <td>
                                <a href="{{ path('subscriber_edit', {id: subscriber.id}) }}" class="btn btn-sm btn-outline-secondary me-1">수정</a>
                                <form method="post" action="{{ path('subscriber_toggle', {id: subscriber.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-subscriber-' ~ subscriber.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-{{ subscriber.isActive() ? 'warning' : 'success' }} me-1">
                                        {{ subscriber.isActive() ? '비활성화' : '활성화' }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('subscriber_delete', {id: subscriber.id}) }}" style="display:inline;"
                                      onsubmit="return confirm('삭제하시겠습니까?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-subscriber-' ~ subscriber.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">삭제</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
