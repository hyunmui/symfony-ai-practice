{% extends 'base.html.twig' %}

{% block title %}대시보드 - 뉴스레터 플랫폼{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">대시보드</h2>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="me-3 text-primary" style="font-size:2.5rem;"><i class="bi bi-newspaper"></i></div>
                <div>
                    <div class="stat-number text-primary">{{ total_newsletters }}</div>
                    <div class="text-muted">총 뉴스레터</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="me-3 text-success" style="font-size:2.5rem;"><i class="bi bi-people-fill"></i></div>
                <div>
                    <div class="stat-number text-success">{{ active_subscribers }}</div>
                    <div class="text-muted">활성 구독자 / {{ total_subscribers }}명</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="me-3 text-purple" style="font-size:2.5rem; color:#764ba2;"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="stat-number" style="color:#764ba2;">AI</div>
                    <div class="text-muted">콘텐츠 자동 생성</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center p-3">
        <span><i class="bi bi-clock-history me-2"></i>최근 뉴스레터</span>
        <a href="{{ path('newsletter_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>새 뉴스레터
        </a>
    </div>
    <div class="card-body p-0">
        {% if newsletters is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-3">아직 작성된 뉴스레터가 없습니다.</p>
                <a href="{{ path('newsletter_new') }}" class="btn btn-primary">첫 번째 뉴스레터 작성</a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>제목</th>
                        <th>상태</th>
                        <th>작성일</th>
                        <th>발송일</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for newsletter in newsletters %}
                        <tr>
                            <td><a href="{{ path('newsletter_show', {id: newsletter.id}) }}" class="text-decoration-none fw-semibold">{{ newsletter.title }}</a></td>
                            <td>
                                {% if newsletter.isDraft() %}
                                    <span class="badge bg-warning text-dark">초안</span>
                                {% else %}
                                    <span class="badge bg-success">발송됨</span>
                                {% endif %}
                            </td>
                            <td>{{ newsletter.createdAt|date('Y-m-d H:i') }}</td>
                            <td>{{ newsletter.sentAt ? newsletter.sentAt|date('Y-m-d H:i') : '-' }}</td>
                            <td><a href="{{ path('newsletter_show', {id: newsletter.id}) }}" class="btn btn-sm btn-outline-secondary">보기</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
